{
  "name": "trayvora-session",
  "displayName": "Trayvora · Active agent session",
  "publisher": "bitcodepro",
  "version": "0.1.0",
  "description": "Share the focused agent session with the local Trayvora app.",
  "engines": { "vscode": "^1.90.0" },
  "extensionKind": ["ui"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "trayvora.pinSession", "title": "Trayvora: Pin Agent Chat to Current Tab" },
      { "command": "trayvora.unpinSession", "title": "Trayvora: Clear Tab Binding" }
    ]
  }
}
